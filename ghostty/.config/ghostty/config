font-family = JetBrains Mono
font-size = 10.5

# Hide tabs (Linux/GTK). On macOS use: macos-titlebar-style = hidden
window-show-tab-bar = never

window-padding-x = 8
window-padding-y = 8

foreground = #24292e
background = #ffffff

cursor-color = #0366d6
cursor-text = #ffffff

selection-background = #24292e
selection-foreground = #ffffff

# ansi (0–7)
palette = 0=#24292e
palette = 1=#d73a49
palette = 2=#28a745
palette = 3=#6f42c1
palette = 4=#0366d6
palette = 5=#6f42c1
palette = 6=#1b7ec2
palette = 7=#e1e4e8
# brights (8–15)
palette = 8=#6a737d
palette = 9=#f97583
palette = 10=#85e89d
palette = 11=#b392f0
palette = 12=#79b8ff
palette = 13=#c8e1ff
palette = 14=#56d4dd
palette = 15=#ffffff

mouse-scroll-multiplier = discrete:1
